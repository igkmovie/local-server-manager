{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Server Manager",
  "version": "0.1.2",
  "identifier": "com.localservermanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Server Manager",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyQjg3NTdEMTkzM0Q0QUYKUldTdjFETVpmWFc0RXUyVUtONWhmK1NNOWVIMlVBU2tPTCtFZ2Y2eUQ2c2ZZS2hnSXRUbWgvUXkK",
      "endpoints": [
        "https://github.com/igkmovie/local-server-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
